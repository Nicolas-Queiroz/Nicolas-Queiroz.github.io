---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  lang: 'pt' | 'en';
  /** Caminho da capa em raster (og:image). SVG não vale: o LinkedIn ignora. */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, lang, image, type = 'website' } = Astro.props;

const pageTitle = title
  ? `${title} • ${profile.name}`
  : `${profile.name} • ${profile.title[lang]}`;

const pageDescription = description ?? profile.bio[lang];
// og:image precisa de URL absoluta.
const imageUrl = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Conteúdo (posts) muda a qualquer novo deploy: impede o ClientRouter
         de servir uma versão em cache da página numa navegação por link. -->
    <meta http-equiv="Cache-Control" content="no-cache" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    {imageUrl && (
      <Fragment>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={imageUrl} />
      </Fragment>
    )}

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <main class="mx-auto max-w-5xl px-6 py-12 md:py-16">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
