---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => data.lang === 'pt'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang="pt" title="Artigos">
  <header class="mb-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Leitura</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-[var(--color-ink)]">Artigos</h1>
    <p class="mt-3 max-w-xl text-[var(--color-muted)]">
      Curadoria automatizada com IA sobre backend, cloud, Python, Odoo e temas relacionados.
    </p>
  </header>

  {posts.length === 0 ? (
    <p class="rounded-xl border border-dashed border-[var(--color-border)] p-6 text-sm italic text-[var(--color-muted)]">
      Ainda não há artigos publicados. Volte em breve.
    </p>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2">
      {posts.map((post) => <ArticleCard post={post} lang="pt" />)}
    </div>
  )}
</BaseLayout>
