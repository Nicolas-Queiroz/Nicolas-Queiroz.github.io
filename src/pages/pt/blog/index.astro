---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => data.lang === 'pt'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang="pt" title="Blog">
  <header class="mb-12">
    <h1 class="display text-[clamp(3rem,10vw,5.5rem)] text-[var(--color-ink)]">Blog</h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Anotações e reflexões sobre backend, cloud, Python, Odoo e o que vou aprendendo no dia a dia.
    </p>
  </header>

  {posts.length === 0 ? (
    <p class="rounded-md border border-dashed border-[var(--color-border)] p-6 text-sm text-[var(--color-muted)]">
      Ainda não há posts publicados. Volte em breve.
    </p>
  ) : (
    <div class="border-b border-[var(--color-border)]">
      {posts.map((post) => <ArticleCard post={post} lang="pt" />)}
    </div>
  )}
</BaseLayout>
