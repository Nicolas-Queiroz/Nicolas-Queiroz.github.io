---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => data.lang === 'pt'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang="pt" title="Notícias">
  <h1 class="mb-2 text-3xl font-bold">Notícias</h1>
  <p class="mb-8 text-[var(--color-muted)]">
    Curadoria automatizada com IA sobre backend, cloud, Python, Odoo e temas relacionados.
  </p>

  {posts.length === 0 ? (
    <p class="text-[var(--color-muted)] italic">Ainda não há posts publicados. Volte em breve.</p>
  ) : (
    <ul class="space-y-6">
      {posts.map((post) => (
        <li class="rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-5">
          <a href={`/pt/noticias/${post.id.replace('pt/', '')}/`} class="block">
            <time datetime={post.data.pubDate.toISOString()} class="text-xs text-[var(--color-muted)]">
              {post.data.pubDate.toLocaleDateString('pt-BR', {
                day: '2-digit', month: 'long', year: 'numeric',
              })}
            </time>
            <h2 class="mt-1 text-xl font-semibold hover:text-[var(--color-accent)]">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((t) => (
                  <span class="rounded bg-slate-100 px-2 py-0.5 text-xs">{t}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
