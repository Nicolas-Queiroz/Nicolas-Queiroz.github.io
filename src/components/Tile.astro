---
import CircuitShape from './CircuitShape.astro';
import type { Piece } from '../lib/circuit';

interface Props {
  piece: Piece;
  index?: number;
  // Rótulo acessível: quando presente, a peça vira um botão que gira.
  label?: string;
}

const { piece, index = 0, label } = Astro.props;
const Tag = label ? 'button' : 'span';
---

<Tag
  class:list={['tile', { 'is-live': piece.live }]}
  style={`--r: ${piece.rotation}deg; --i: ${index}`}
  type={label ? 'button' : undefined}
  aria-label={label}
  data-piece={label ? '' : undefined}
  data-mask={piece.mask}
  data-rotation={piece.rotation}
  data-node={piece.node}
>
  <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <CircuitShape piece={piece} />
  </svg>
</Tag>
