---
import Tile from './Tile.astro';
import { makeCircuit } from '../lib/circuit';

interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className = '' } = Astro.props;
const pieces = makeCircuit(seed, 2, 2, { routes: 1 });
---

<span class={`tile-stamp ${className}`} aria-hidden="true">
  {pieces.map((piece, i) => <Tile piece={piece} index={i} />)}
</span>
