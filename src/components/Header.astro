---
import ThemeToggle from './ThemeToggle.astro';
import TileStamp from './TileStamp.astro';
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const labels = {
  pt: {
    home: 'Início',
    blog: 'Blog',
    about: 'Sobre',
    otherLang: 'EN',
  },
  en: {
    home: 'Home',
    blog: 'Blog',
    about: 'About',
    otherLang: 'PT',
  },
};

const t = labels[lang];
const basePath = `/${lang}`;
const blogPath = `/${lang}/blog`;
const aboutPath = lang === 'pt' ? '/pt/sobre' : '/en/about';

const path = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
// Home só fica ativo em match exato — senão "/pt" (prefixo de tudo) ficaria
// sempre marcado junto com a seção atual.
const isActive = (href: string, exact = false) => {
  const clean = href.replace(/\/$/, '');
  return exact ? path === clean : path === clean || path.startsWith(`${clean}/`);
};

// Preserva a seção atual ao trocar de idioma (a página exata pode não existir
// no outro idioma, ex.: slugs de posts diferem, então cai no índice da seção).
function otherLangHref(): string {
  const other = lang === 'pt' ? 'en' : 'pt';
  if (path === basePath) return `/${other}`;
  if (path.startsWith(aboutPath)) return other === 'pt' ? '/pt/sobre' : '/en/about';
  if (path.startsWith(blogPath)) return `/${other}/blog`;
  return `/${other}`;
}

const otherLangPath = otherLangHref();
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-6 py-3.5">
    <a href={basePath} class="group flex items-center gap-2.5 hover:text-[var(--color-accent)]">
      <TileStamp seed="nicolas-queiroz" class="w-7" />
      <span class="heading hidden text-base sm:inline">
        {profile.name.split(' ')[0]} {profile.name.split(' ').slice(-1)}
      </span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex items-center text-sm font-medium">
        {[
          { href: basePath, label: t.home, active: isActive(basePath, true) },
          { href: blogPath, label: t.blog, active: isActive(blogPath) },
          { href: aboutPath, label: t.about, active: isActive(aboutPath) },
        ].map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class={`block px-2.5 py-2 transition sm:px-3 ${item.active ? 'text-[var(--color-ink)] shadow-[inset_0_-2px_0_var(--color-accent)]' : 'text-[var(--color-muted)] hover:text-[var(--color-ink)]'}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={otherLangPath}
        class="rounded-md border border-[var(--color-border)] px-2 py-1 text-xs font-semibold text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t.otherLang}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>
