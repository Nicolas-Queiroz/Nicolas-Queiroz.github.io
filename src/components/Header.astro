---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const labels = {
  pt: {
    home: 'Início',
    blog: 'Blog',
    about: 'Sobre',
    otherLang: 'EN',
  },
  en: {
    home: 'Home',
    blog: 'Blog',
    about: 'About',
    otherLang: 'PT',
  },
};

const t = labels[lang];
const basePath = `/${lang}`;
const blogPath = `/${lang}/blog`;
const aboutPath = lang === 'pt' ? '/pt/sobre' : '/en/about';

const path = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
// Home só fica ativo em match exato — senão "/pt" (prefixo de tudo) ficaria
// sempre marcado junto com a seção atual.
const isActive = (href: string, exact = false) => {
  const clean = href.replace(/\/$/, '');
  return exact ? path === clean : path === clean || path.startsWith(`${clean}/`);
};

// Preserva a seção atual ao trocar de idioma (a página exata pode não existir
// no outro idioma, ex.: slugs de posts diferem, então cai no índice da seção).
function otherLangHref(): string {
  const other = lang === 'pt' ? 'en' : 'pt';
  if (path === basePath) return `/${other}`;
  if (path.startsWith(aboutPath)) return other === 'pt' ? '/pt/sobre' : '/en/about';
  if (path.startsWith(blogPath)) return `/${other}/blog`;
  return `/${other}`;
}

const otherLangPath = otherLangHref();
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href={basePath} class="font-serif text-lg font-semibold tracking-tight hover:text-[var(--color-accent)]">
      {profile.name.split(' ')[0]} {profile.name.split(' ').slice(-1)}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 text-sm font-medium sm:gap-2">
        <li>
          <a
            href={basePath}
            aria-current={isActive(basePath, true) ? 'page' : undefined}
            class={`rounded-full px-3 py-1.5 transition ${isActive(basePath, true) ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]' : 'text-[var(--color-ink-soft)] hover:text-[var(--color-accent)]'}`}
          >
            {t.home}
          </a>
        </li>
        <li>
          <a
            href={blogPath}
            aria-current={isActive(blogPath) ? 'page' : undefined}
            class={`rounded-full px-3 py-1.5 transition ${isActive(blogPath) ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]' : 'text-[var(--color-ink-soft)] hover:text-[var(--color-accent)]'}`}
          >
            {t.blog}
          </a>
        </li>
        <li>
          <a
            href={aboutPath}
            aria-current={isActive(aboutPath) ? 'page' : undefined}
            class={`rounded-full px-3 py-1.5 transition ${isActive(aboutPath) ? 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]' : 'text-[var(--color-ink-soft)] hover:text-[var(--color-accent)]'}`}
          >
            {t.about}
          </a>
        </li>
      </ul>
      <a
        href={otherLangPath}
        class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs font-semibold uppercase text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t.otherLang}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>
