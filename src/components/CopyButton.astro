---
// Botão que copia um texto para a área de transferência e confirma no próprio rótulo.
// - `value`: copia esse texto.
// - `from`: copia o textContent do elemento casado pelo seletor (para textos
//   multilinha, que não cabem bem num atributo).
// - Sem os dois: copia a URL da página atual.
interface Props {
  value?: string;
  from?: string;
  label: string;
  copiedLabel: string;
  class?: string;
}

const { value, from, label, copiedLabel, class: className = 'btn btn-ghost' } = Astro.props;
---

<button type="button" class={className} data-copy={value ?? ''} data-copy-from={from} data-copied-label={copiedLabel}>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
    <rect x="9" y="9" width="13" height="13" rx="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  </svg>
  <span data-copy-label>{label}</span>
</button>

<script data-astro-rerun is:inline>
  function initCopyButtons() {
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
      // onclick (não addEventListener) para não empilhar handlers entre navegações do ClientRouter.
      btn.onclick = function () {
        var source = btn.dataset.copyFrom && document.querySelector(btn.dataset.copyFrom);
        var text = source ? source.textContent : btn.dataset.copy || window.location.href;
        var labelEl = btn.querySelector('[data-copy-label]');
        var original = btn.dataset.originalLabel || labelEl.textContent;
        btn.dataset.originalLabel = original;
        navigator.clipboard.writeText(text).then(function () {
          labelEl.textContent = btn.dataset.copiedLabel;
          clearTimeout(btn._copyTimer);
          btn._copyTimer = setTimeout(function () {
            labelEl.textContent = original;
          }, 2000);
        });
      };
    });
  }

  initCopyButtons();
</script>
