---
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const t = {
  pt: {
    about: 'Sobre',
    skills: 'Habilidades',
    experience: 'Experiência',
    projects: 'Projetos',
    education: 'Educação',
    languages: 'Idiomas',
    readNews: 'Ver últimas notícias →',
    contact: 'Contato',
    langLabels: {
      languages: 'Linguagens',
      frameworks: 'Frameworks',
      databases: 'Bancos de dados',
      cloud: 'Cloud & DevOps',
      integration: 'Integração',
      tools: 'Ferramentas',
    },
  },
  en: {
    about: 'About',
    skills: 'Skills',
    experience: 'Experience',
    projects: 'Projects',
    education: 'Education',
    languages: 'Languages',
    readNews: 'Read latest news →',
    contact: 'Contact',
    langLabels: {
      languages: 'Languages',
      frameworks: 'Frameworks',
      databases: 'Databases',
      cloud: 'Cloud & DevOps',
      integration: 'Integration',
      tools: 'Tools',
    },
  },
}[lang];

const newsPath = lang === 'pt' ? '/pt/noticias' : '/en/news';
---

<section class="mb-12">
  <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
    {profile.name}
  </h1>
  <p class="mt-2 text-xl text-[var(--color-accent)]">{profile.title[lang]}</p>
  <p class="mt-1 text-sm text-[var(--color-muted)]">📍 {profile.location}</p>
</section>

<section class="mb-12">
  <h2 class="mb-3 text-xl font-semibold">{t.about}</h2>
  <p class="text-[var(--color-ink-soft)] leading-relaxed">{profile.bio[lang]}</p>
  <a
    href={newsPath}
    class="mt-4 inline-block text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]"
  >
    {t.readNews}
  </a>
</section>

<section class="mb-12">
  <h2 class="mb-4 text-xl font-semibold">{t.skills}</h2>
  <div class="grid gap-4 md:grid-cols-2">
    {Object.entries(profile.skills).map(([key, values]) => (
      <div>
        <h3 class="mb-2 text-sm font-semibold text-[var(--color-muted)] uppercase tracking-wide">
          {t.langLabels[key as keyof typeof t.langLabels]}
        </h3>
        <div class="flex flex-wrap gap-2">
          {values.map((skill) => (
            <span class="rounded-md border border-[var(--color-border)] bg-[var(--color-card)] px-3 py-1 text-sm">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="mb-12">
  <h2 class="mb-4 text-xl font-semibold">{t.experience}</h2>
  {profile.experience.map((exp) => (
    <article class="mb-6 rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-5">
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="text-lg font-semibold">{exp.role[lang]}</h3>
        <span class="text-sm text-[var(--color-muted)]">{exp.period}</span>
      </div>
      <p class="mb-3 text-sm font-medium text-[var(--color-ink-soft)]">{exp.company}</p>
      <ul class="space-y-1.5 text-sm text-[var(--color-ink-soft)]">
        {exp.bullets[lang].map((b) => (
          <li class="flex gap-2">
            <span class="text-[var(--color-accent)]">•</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </article>
  ))}
</section>

<section class="mb-12">
  <h2 class="mb-4 text-xl font-semibold">{t.projects}</h2>
  {profile.projects.map((p) => (
    <article class="mb-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-5">
      <h3 class="mb-2 text-lg font-semibold">{p.name}</h3>
      <p class="mb-3 text-sm text-[var(--color-ink-soft)]">{p.description[lang]}</p>
      <div class="flex flex-wrap gap-2">
        {p.tags.map((tag) => (
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">
            {tag}
          </span>
        ))}
      </div>
    </article>
  ))}
</section>

<section class="mb-12 grid gap-6 md:grid-cols-2">
  <div>
    <h2 class="mb-3 text-xl font-semibold">{t.education}</h2>
    <p class="font-medium">{profile.education.course[lang]}</p>
    <p class="text-sm text-[var(--color-ink-soft)]">{profile.education.school[lang]}</p>
    <p class="text-sm text-[var(--color-muted)]">{profile.education.period}</p>
  </div>
  <div>
    <h2 class="mb-3 text-xl font-semibold">{t.languages}</h2>
    <ul class="space-y-1 text-sm">
      {profile.languages[lang].map((l) => (
        <li>
          <span class="font-medium">{l.name}:</span>{' '}
          <span class="text-[var(--color-ink-soft)]">{l.level}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="mb-12">
  <h2 class="mb-3 text-xl font-semibold">{t.contact}</h2>
  <ul class="space-y-1 text-sm">
    <li>📧 <a href={`mailto:${profile.email}`} class="text-[var(--color-accent)] hover:underline">{profile.email}</a></li>
    <li>📱 {profile.phone}</li>
    <li>💼 <a href={profile.linkedin} target="_blank" rel="noopener" class="text-[var(--color-accent)] hover:underline">LinkedIn</a></li>
    <li>💻 <a href={profile.github} target="_blank" rel="noopener" class="text-[var(--color-accent)] hover:underline">GitHub</a></li>
  </ul>
</section>
