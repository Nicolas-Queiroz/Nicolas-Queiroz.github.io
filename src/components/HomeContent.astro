---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const t = {
  pt: {
    kicker: 'Portfólio & artigos',
    tagline: 'Escrevo sobre backend, cloud e o que aprendo construindo software no dia a dia.',
    readArticles: 'Ver artigos',
    aboutMe: 'Sobre mim',
    latest: 'Últimos artigos',
    seeAll: 'Ver todos os artigos →',
    empty: 'Ainda não há artigos publicados. Volte em breve.',
  },
  en: {
    kicker: 'Portfolio & writing',
    tagline: 'I write about backend, cloud, and what I learn building software day to day.',
    readArticles: 'Read articles',
    aboutMe: 'About me',
    latest: 'Latest articles',
    seeAll: 'See all articles →',
    empty: 'No articles published yet. Check back soon.',
  },
}[lang];

const articlesPath = lang === 'pt' ? '/pt/artigos' : '/en/articles';
const aboutPath = lang === 'pt' ? '/pt/sobre' : '/en/about';

const posts = (await getCollection('posts', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const initials = profile.name
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<section class="mb-16 flex flex-col items-start gap-8 sm:flex-row sm:items-center">
  <div
    class="grid h-20 w-20 shrink-0 place-items-center rounded-full border border-[var(--color-border)] bg-[var(--color-bg-soft)] font-serif text-2xl font-semibold text-[var(--color-accent)]"
  >
    {initials}
  </div>
  <div>
    <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{t.kicker}</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-[var(--color-ink)] md:text-5xl">
      {profile.name}
    </h1>
    <p class="mt-3 max-w-xl text-lg text-[var(--color-ink-soft)]">{t.tagline}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={articlesPath}
        class="rounded-full bg-[var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-[#06131a] transition hover:bg-[var(--color-accent-hover)]"
      >
        {t.readArticles}
      </a>
      <a
        href={aboutPath}
        class="rounded-full border border-[var(--color-border)] px-5 py-2.5 text-sm font-semibold text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t.aboutMe}
      </a>
    </div>
  </div>
</section>

<section>
  <div class="mb-5 flex items-center justify-between">
    <h2 class="font-serif text-2xl font-semibold text-[var(--color-ink)]">{t.latest}</h2>
    {posts.length > 0 && (
      <a href={articlesPath} class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
        {t.seeAll}
      </a>
    )}
  </div>

  {posts.length === 0 ? (
    <p class="rounded-xl border border-dashed border-[var(--color-border)] p-6 text-sm italic text-[var(--color-muted)]">
      {t.empty}
    </p>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2">
      {posts.map((post) => <ArticleCard post={post} lang={lang} />)}
    </div>
  )}
</section>
