---
// Página inicial: apresentação, o que estou fazendo agora e os últimos posts.
// O currículo completo mora em /pt/sobre e /en/about.
import ArticleCard from './ArticleCard.astro';
import ContactSection from './ContactSection.astro';
import TileWall from './TileWall.astro';
import { profile } from '../data/profile';
import { getPosts, type Lang } from '../lib/posts';
import { resumeHref } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const city = profile.location.split(',')[0];

const t = {
  pt: {
    role: `${profile.title.pt} em ${city}.`,
    email: 'Enviar e-mail',
    now: 'Agora',
    stack: 'No dia a dia',
    resume: 'Ver o currículo completo',
    latest: 'Do blog',
    seeAll: 'Ver todos os posts',
  },
  en: {
    role: `${profile.title.en} in ${city}.`,
    email: 'Send an email',
    now: 'Now',
    stack: 'Day to day',
    resume: 'See the full resume',
    latest: 'From the blog',
    seeAll: 'See all posts',
  },
}[lang];

const posts = (await getPosts(lang)).slice(0, 3);
const [firstName, ...restName] = profile.name.split(' ');
const current = profile.experience[0];
const dailyStack = [...profile.skills.languages, ...profile.skills.frameworks, ...profile.skills.databases, ...profile.skills.cloud];
---

<section class="mb-24 grid items-center gap-12 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-14">
  <div>
    <h1 class="display text-[clamp(2.4rem,7.2vw,4.25rem)] text-[var(--color-ink)]">
      <span class="block">{firstName}</span>
      <span class="block">{restName.join(' ')}</span>
    </h1>
    <p class="heading mt-6 text-xl text-[var(--color-accent)] md:text-2xl">{t.role}</p>
    <p class="mt-4 max-w-xl font-serif text-xl leading-relaxed text-[var(--color-ink-soft)]">{profile.bio[lang]}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary">{t.email}</a>
      <a href={resumeHref(lang)} class="btn btn-ghost">{t.resume}</a>
    </div>
  </div>
  <TileWall lang={lang} />
</section>

<section class="mb-24 rounded-md bg-[var(--color-card)] p-6 md:p-10">
  <p class="flex flex-wrap items-center gap-3 text-sm text-[var(--color-muted)]">
    {t.now}
    <span class="chip text-[var(--color-accent)]">{current.period}</span>
  </p>
  <h2 class="heading mt-2 text-2xl text-[var(--color-ink)] md:text-3xl">{current.role[lang]}</h2>
  <p class="mt-0.5 font-medium text-[var(--color-ink-soft)]">{current.company}</p>
  <p class="mt-5 max-w-2xl font-serif text-lg leading-relaxed text-[var(--color-ink-soft)]">
    {current.bullets[lang][0]}
  </p>

  <p class="mt-8 text-sm text-[var(--color-muted)]">{t.stack}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {dailyStack.map((skill) => <span class="chip">{skill}</span>)}
  </div>

  <a href={resumeHref(lang)} class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
    {t.resume}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
      <path d="M5 12h14"></path>
      <path d="m13 6 6 6-6 6"></path>
    </svg>
  </a>
</section>

{posts.length > 0 && (
  <section class="mb-24">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="heading text-2xl text-[var(--color-ink)] md:text-3xl">{t.latest}</h2>
      <a href={`/${lang}/blog`} class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">{t.seeAll}</a>
    </div>
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">
      {posts.map((post) => <ArticleCard post={post} headingLevel="h3" />)}
    </div>
  </section>
)}

<ContactSection lang={lang} />
