---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import TileWall from './TileWall.astro';
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const city = profile.location.split(',')[0];

const t = {
  pt: {
    role: `${profile.title.pt} em ${city}.`,
    tagline: 'Escrevo sobre backend, cloud e o que aprendo construindo software no dia a dia.',
    readArticles: 'Ler o blog',
    aboutMe: 'Sobre mim',
    latest: 'Últimos posts',
    seeAll: 'Ver todos os posts',
    empty: 'Ainda não há posts publicados. Volte em breve.',
  },
  en: {
    role: `${profile.title.en} in ${city}.`,
    tagline: 'I write about backend, cloud, and what I learn building software day to day.',
    readArticles: 'Read the blog',
    aboutMe: 'About me',
    latest: 'Latest posts',
    seeAll: 'See all posts',
    empty: 'No posts published yet. Check back soon.',
  },
}[lang];

const articlesPath = `/${lang}/blog`;
const aboutPath = lang === 'pt' ? '/pt/sobre' : '/en/about';

const posts = (await getCollection('posts', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Quebra o nome em duas linhas: primeiro nome e o restante.
const [firstName, ...restName] = profile.name.split(' ');
---

<section class="mb-20 grid items-center gap-10 md:mb-28 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-14">
  <div>
    <h1 class="display text-[clamp(2.4rem,7.2vw,4.25rem)] text-[var(--color-ink)]">
      <span class="block">{firstName}</span>
      <span class="block">{restName.join(' ')}</span>
    </h1>
    <p class="heading mt-6 text-xl text-[var(--color-accent)] md:text-2xl">{t.role}</p>
    <p class="mt-3 max-w-lg text-lg leading-relaxed text-[var(--color-ink-soft)]">{t.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={articlesPath} class="btn btn-primary">{t.readArticles}</a>
      <a href={aboutPath} class="btn btn-ghost">{t.aboutMe}</a>
    </div>
  </div>
  <div>
    <TileWall lang={lang} />
  </div>
</section>

<section>
  <div class="mb-2 flex items-baseline justify-between gap-4">
    <h2 class="heading text-2xl text-[var(--color-ink)] md:text-3xl">{t.latest}</h2>
    {posts.length > 0 && (
      <a href={articlesPath} class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
        {t.seeAll}
      </a>
    )}
  </div>

  {posts.length === 0 ? (
    <p class="rounded-md border border-dashed border-[var(--color-border)] p-6 text-sm text-[var(--color-muted)]">
      {t.empty}
    </p>
  ) : (
    <div class="border-b border-[var(--color-border)]">
      {posts.map((post) => <ArticleCard post={post} lang={lang} />)}
    </div>
  )}
</section>
