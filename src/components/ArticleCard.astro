---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'pt' | 'en';
}

const { post, lang } = Astro.props;

const slug = post.id.replace(`${lang}/`, '');
const href = `/${lang}/blog/${slug}/`;

const locale = lang === 'pt' ? 'pt-BR' : 'en-US';

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readMinutes = wordCount ? Math.max(1, Math.round(wordCount / 200)) : null;
const readingLabel = lang === 'pt' ? `${readMinutes} min de leitura` : `${readMinutes} min read`;
---

<a
  href={href}
  class="group block overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-card-hover)] hover:shadow-lg hover:shadow-black/20"
>
  {post.data.image && (
    <img
      src={post.data.image}
      alt={post.data.title}
      class="h-40 w-full border-b border-[var(--color-border)] object-cover"
      loading="lazy"
    />
  )}
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--color-muted)]">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString(locale, { day: '2-digit', month: 'long', year: 'numeric' })}
      </time>
      {readMinutes && (
        <>
          <span aria-hidden="true">·</span>
          <span>{readingLabel}</span>
        </>
      )}
    </div>
    <h2 class="mt-2 font-serif text-xl font-semibold text-[var(--color-ink)] transition group-hover:text-[var(--color-accent)]">
      {post.data.title}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">{post.data.description}</p>
    {post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )}
  </div>
</a>
