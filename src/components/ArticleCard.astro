---
import PostCover from './PostCover.astro';
import { formatDate, postHref, readingLabel, type Post } from '../lib/posts';

interface Props {
  post: Post;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const lang = post.data.lang;
---

<a
  href={postHref(post)}
  data-post-card
  data-tags={post.data.tags.join('|')}
  class:list={[
    'post-card group grid content-start gap-5',
    featured && 'md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:gap-10',
  ]}
>
  <PostCover post={post} class="post-card-cover" />
  <div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-[var(--color-muted)]">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <span>{readingLabel(post)}</span>
    </div>
    <Heading
      class:list={[
        'heading mt-2 text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)]',
        featured ? 'text-2xl md:text-4xl' : 'text-xl md:text-2xl',
      ]}
    >
      {post.data.title}
    </Heading>
    <p class:list={['mt-3 leading-relaxed text-[var(--color-ink-soft)]', featured ? 'text-lg' : 'line-clamp-3']}>
      {post.data.description}
    </p>
    {post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )}
  </div>
</a>
