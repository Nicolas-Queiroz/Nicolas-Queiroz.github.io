---
import type { CollectionEntry } from 'astro:content';
import TileStamp from './TileStamp.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: 'pt' | 'en';
}

const { post, lang } = Astro.props;

const slug = post.id.replace(`${lang}/`, '');
const href = `/${lang}/blog/${slug}/`;

const locale = lang === 'pt' ? 'pt-BR' : 'en-US';

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readMinutes = wordCount ? Math.max(1, Math.round(wordCount / 200)) : null;
const readingLabel = lang === 'pt' ? `${readMinutes} min de leitura` : `${readMinutes} min read`;
---

<a
  href={href}
  class="group grid grid-cols-[3rem_minmax(0,1fr)] gap-4 border-t border-[var(--color-border)] py-7 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-7"
>
  <TileStamp seed={post.data.source ?? post.id} class="mt-1" />
  <div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-[var(--color-muted)]">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
      {readMinutes && <span>{readingLabel}</span>}
    </div>
    <h2 class="heading mt-1.5 text-xl text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)] md:text-2xl">
      {post.data.title}
    </h2>
    <p class="mt-2 max-w-2xl leading-relaxed text-[var(--color-ink-soft)]">{post.data.description}</p>
    {post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    )}
  </div>
</a>
