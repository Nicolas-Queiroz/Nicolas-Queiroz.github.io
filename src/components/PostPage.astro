---
// Página de post compartilhada entre PT e EN. O conteúdo renderizado entra pelo slot.
import ArticleCard from './ArticleCard.astro';
import BackButton from './BackButton.astro';
import CopyButton from './CopyButton.astro';
import PostCover from './PostCover.astro';
import ReadingProgress from './ReadingProgress.astro';
import {
  coverPng,
  formatDate,
  linkedinPost,
  postHref,
  readingLabel,
  relatedPosts,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const lang = post.data.lang;
const related = relatedPosts(post, posts);

const postUrl = new URL(postHref(post), Astro.site ?? Astro.url).href;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
const linkedinText = linkedinPost(post, postUrl);
const png = coverPng(post);

const t = {
  pt: {
    allPosts: 'Todos os posts',
    share: 'Compartilhar',
    copyLink: 'Copiar link',
    copied: 'Link copiado',
    publish: 'Publicar no LinkedIn',
    publishHint: 'Texto e capa prontos para colar.',
    copyText: 'Copiar texto',
    textCopied: 'Texto copiado',
    download: 'Baixar a capa',
    openLinkedin: 'Abrir o LinkedIn',
    source: 'Fonte original',
    keepReading: 'Continue lendo',
    back: 'Voltar para o blog',
  },
  en: {
    allPosts: 'All posts',
    share: 'Share',
    copyLink: 'Copy link',
    copied: 'Link copied',
    publish: 'Post on LinkedIn',
    publishHint: 'Text and cover ready to paste.',
    copyText: 'Copy text',
    textCopied: 'Text copied',
    download: 'Download the cover',
    openLinkedin: 'Open LinkedIn',
    source: 'Original source',
    keepReading: 'Keep reading',
    back: 'Back to blog',
  },
}[lang];
---

<ReadingProgress />

<article data-reading-target>
  <header>
    <BackButton href={`/${lang}/blog`} label={t.allPosts} />
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-[var(--color-muted)]">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <span>{readingLabel(post)}</span>
    </div>
    <h1 class="display mt-4 max-w-4xl text-[clamp(2rem,5.5vw,3.5rem)] leading-[1.02] text-[var(--color-ink)]">
      {post.data.title}
    </h1>
    <p class="mt-5 max-w-2xl font-serif text-xl leading-relaxed text-[var(--color-ink-soft)] md:text-2xl">
      {post.data.description}
    </p>
    {post.data.tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <a href={`/${lang}/blog/?tag=${encodeURIComponent(tag)}`} class="chip hover:text-[var(--color-accent)]">{tag}</a>
        ))}
      </div>
    )}
  </header>

  <PostCover post={post} class="post-cover-hero mt-10" />

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_13rem]">
    <div class="prose-post">
      <slot />
    </div>

    <aside class="self-start lg:sticky lg:top-24">
      <h2 class="text-sm text-[var(--color-muted)]">{t.share}</h2>
      <div class="mt-3 flex flex-wrap gap-2 lg:flex-col">
        <CopyButton label={t.copyLink} copiedLabel={t.copied} class="btn btn-ghost gap-2" />
        <a href="#linkedin" class="btn btn-ghost gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
          </svg>
          LinkedIn
        </a>
      </div>
      {post.data.source && (
        <p class="mt-6 text-sm text-[var(--color-muted)]">
          {t.source}:{' '}
          <a href={post.data.source} target="_blank" rel="noopener" class="font-medium text-[var(--color-ink)] underline decoration-[var(--color-accent)] decoration-2 underline-offset-4 hover:text-[var(--color-accent)]">
            {post.data.sourceName ?? post.data.source}
          </a>
        </p>
      )}
    </aside>
  </div>
</article>

<section id="linkedin" class="mt-20 scroll-mt-24">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 class="heading text-xl text-[var(--color-ink)] md:text-2xl">{t.publish}</h2>
    <p class="text-sm text-[var(--color-muted)]">{t.publishHint}</p>
  </div>

  <div class="mt-5 grid gap-6 rounded-md border border-[var(--color-border)] bg-[var(--color-card)] p-5 md:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] md:p-6">
    {png && (
      <img
        src={png}
        alt=""
        width="1200"
        height="630"
        loading="lazy"
        class="w-full self-start rounded-md border border-[var(--color-border)]"
      />
    )}
    <div>
      <pre class="linkedin-text" data-linkedin-text>{linkedinText}</pre>
      <div class="mt-4 flex flex-wrap gap-2">
        <CopyButton from="[data-linkedin-text]" label={t.copyText} copiedLabel={t.textCopied} class="btn btn-primary gap-2" />
        {png && (
          <a href={png} download class="btn btn-ghost gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M12 3v12"></path>
              <path d="m7 12 5 5 5-5"></path>
              <path d="M4 21h16"></path>
            </svg>
            {t.download}
          </a>
        )}
        <a href={shareUrl} target="_blank" rel="noopener" class="btn btn-ghost gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
          </svg>
          {t.openLinkedin}
        </a>
      </div>
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="mt-24 border-t border-[var(--color-border)] pt-12">
    <h2 class="heading text-2xl text-[var(--color-ink)] md:text-3xl">{t.keepReading}</h2>
    <div class="mt-8 grid gap-10 md:grid-cols-2">
      {related.map((p) => <ArticleCard post={p} headingLevel="h3" />)}
    </div>
  </section>
)}

<div class="mt-12">
  <BackButton href={`/${lang}/blog`} label={t.back} />
</div>
