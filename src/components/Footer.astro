---
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

const t = {
  pt: {
    ai: 'Este é meu blog pessoal. Alguns posts nascem de notícias que leio e são rascunhados com ajuda de um agente de IA que desenvolvi, sempre revisados e editados por mim antes de publicar.',
    copyright: `© ${new Date().getFullYear()} ${profile.name}. Feito com Astro.`,
  },
  en: {
    ai: 'This is my personal blog. Some posts start from news I read and are drafted with help from an AI agent I built, always reviewed and edited by me before publishing.',
    copyright: `© ${new Date().getFullYear()} ${profile.name}. Built with Astro.`,
  },
}[lang];
---

<footer class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-bg-soft)]">
  <div class="mx-auto max-w-5xl px-6 py-12 text-sm text-[var(--color-muted)]">
    <p class="mb-8 max-w-2xl font-serif text-lg italic leading-relaxed text-[var(--color-ink-soft)]">{t.ai}</p>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-[var(--color-border)] pt-6">
      <p>{t.copyright}</p>
      <div class="flex gap-5">
        <a href={profile.github} target="_blank" rel="noopener" class="transition hover:text-[var(--color-ink)]">
          GitHub
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener" class="transition hover:text-[var(--color-ink)]">
          LinkedIn
        </a>
        <a href={`mailto:${profile.email}`} class="transition hover:text-[var(--color-ink)]">
          Email
        </a>
      </div>
    </div>
  </div>
</footer>
