---
interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
const label = lang === 'pt' ? 'Alternar tema' : 'Toggle theme';
---

<button
  id="theme-toggle"
  type="button"
  aria-label={label}
  title={label}
  class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-[var(--color-border)] text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
>
  <svg data-icon="sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4.5 w-4.5">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg data-icon="moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4.5 w-4.5">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  function applyIcon(theme: string) {
    document.querySelectorAll('#theme-toggle').forEach((btn) => {
      const sun = btn.querySelector('[data-icon="sun"]');
      const moon = btn.querySelector('[data-icon="moon"]');
      sun?.classList.toggle('hidden', theme !== 'dark');
      moon?.classList.toggle('hidden', theme === 'dark');
    });
  }

  function currentTheme() {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function init() {
    applyIcon(currentTheme());
    document.querySelectorAll('#theme-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        applyIcon(next);
      });
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
